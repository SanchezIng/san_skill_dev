{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/arranque.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/secure_guard.sh",
            "timeout": 10,
            "statusMessage": "Comprobando secure-coding-guard..."
          }
        ]
      }
    ]
  }
}
